# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (unanchored — applies to frontend/ and backend/ workspaces too)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js (unanchored — per-workspace .next outputs)
.next/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (never commit secrets; keep only *.example files tracked)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# stray local test/debug artifacts (may contain tokens)
backend/local-token.txt
backend/tmp-token.txt
backend/verify-temp.ts
tmp-curlcookies.txt
tmp-login.json
