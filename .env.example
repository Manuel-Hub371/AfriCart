# Database
DATABASE_URL="postgresql://user:password@localhost:5432/africart"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-at-least-32-characters-long"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# API URL - Base URL of the backend API (must be an absolute http(s) URL to enable
# the frontend/API split). Empty or relative (e.g. "/api") means same-origin monolith
# and uses relative /api paths. Example (split): "https://africart-api.onrender.com".
NEXT_PUBLIC_API_URL=""

# API INTERNAL URL - Server-side only base URL for the backend (preferred over
# NEXT_PUBLIC_API_URL on the server). Useful when the frontend server reaches the
# backend over an internal/private URL. Same rules as NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=""

# Cookie SameSite policy for auth cookies. Keep "lax" for the same-origin monolith.
# Set to "none" (requires HTTPS) only when frontend and API are on different sites.
COOKIE_SAME_SITE="lax"

# Email Service (Optional - uses console fallback in development)
RESEND_API_KEY=""
SENDGRID_API_KEY=""
EMAIL_FROM="AfriCart Support <noreply@africart.com>"

# Media - Cloudinary (Optional. If unset, falls back to base64/DB storage).
# Used only when all three are provided.
CLOUDINARY_CLOUD_NAME="AfriCart"
CLOUDINARY_API_KEY="445715118712335"
CLOUDINARY_API_SECRET="zTExtYV10ockeEVg60pDrW1jrDs"

# CORS - Comma-separated list of allowed frontend origins (render/vercel/netlify).
ALLOWED_ORIGINS="http://localhost:3000"

# Node Environment
NODE_ENV="development"

# Logging - Level for the structured logger (debug | info | warn | error).
LOG_LEVEL="info"
