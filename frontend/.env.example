# AfriCart Frontend - Environment Variables (names only, no real secrets).
# Copy to frontend/.env.local and fill in values for local development.
#
# Scope legend:
#   PUBLIC   - $(NEXT_PUBLIC_) vars are inlined into the browser bundle; safe to expose
#   SERVER   - visible to the server/Edge runtime only

# --- Backend API (PUBLIC) ----------------------------------------------
# Base URL of the backend API the frontend talks to. Must be an absolute
# http(s) URL in the split architecture.
#   dev:      http://localhost:3001
#   prod:     https://api.africart.com
NEXT_PUBLIC_API_URL="http://localhost:3001"

# --- Public app URL (PUBLIC) -------------------------------------------
# Canonical origin of the frontend itself.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Internal API URL (SERVER, optional) --------------------------------
# Server-side-only base URL for the backend, preferred over NEXT_PUBLIC_API_URL
# when the frontend server must reach the backend over a private/internal URL.
API_INTERNAL_URL=""