# AfriCart Backend - Environment Variables (names only, no real secrets).
# Copy to backend/.env.local and fill in values for local development.
#
# Scope legend:
#   BACKEND  - server-side secret/credential for the API service
#   INTEGRATION - server-side credential for an external service
#   PUBLIC   - safe to expose (used for links / CORS defaults only)

# --- Database (BACKEND) ------------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/africart"

# --- Authentication (BACKEND) ------------------------------------------
# Required (>= 32 chars). Used to sign/verify access & refresh JWTs.
# Production MUST set this; the backend fails fast at startup if missing.
JWT_SECRET="changeme-please-use-a-long-random-secret-at-least-32-chars"

# Cookie SameSite policy for auth cookies. "lax" (default) for same-site
# frontend/API. "none" (+ HTTPS) ONLY when frontend and API are different sites.
COOKIE_SAME_SITE="lax"

# --- CORS (BACKEND) -----------------------------------------------------
# Comma-separated list of allowed frontend origins.
# e.g. http://localhost:3000,https://www.africart.com
ALLOWED_ORIGINS="http://localhost:3000"

# Public app URL used for email links and as a CORS default. Not a secret.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Media - Cloudinary (INTEGRATION) -----------------------------------
# All three are required for Cloudinary uploads. If unset, uploads fall back
# to the development-only storage path (never in production).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Email (INTEGRATION, optional) --------------------------------------
# One of RESEND_API_KEY or SENDGRID_API_KEY may be set to enable real email.
RESEND_API_KEY=""
EMAIL_FROM="AfriCart Support <noreply@africart.com>"

# --- Observability (BACKEND) --------------------------------------------
# Log level for the structured logger: debug | info | warn | error
LOG_LEVEL="info"

# --- Runtime -------------------------------------------------------------
NODE_ENV="development"